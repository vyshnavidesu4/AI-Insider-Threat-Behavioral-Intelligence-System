# ==============================================================================
# DATABASE CONNECTION STRING (DATABASE_URL)
# ==============================================================================
# Option 1: Local PostgreSQL (standard local installation)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threat_intel_db

# Option 2: Neon Serverless Postgres (Free tier - https://neon.tech)
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 3: Supabase PostgreSQL (Free tier - https://supabase.com)
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Option 4: Local SQLite file (Instant zero-install test fallback)
# DATABASE_URL=sqlite:///./threat_intel.db

# ==============================================================================
# JWT AUTHENTICATION SECRETS
# ==============================================================================
JWT_SECRET_KEY=regional-bank-soc-insecure-dev-secret-key-change-in-production-93821038
JWT_REFRESH_SECRET_KEY=regional-bank-soc-insecure-refresh-dev-secret-key-change-in-production-192837
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# ENVIRONMENT & CORS
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
